<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicPlayer2_Avalonia.ViewModels.Settings"
             xmlns:settings="using:MusicPlayer2_Avalonia.Application.Settings.Models"
             xmlns:audio="using:MusicPlayer2_Avalonia.Application.Common"
             x:Class="MusicPlayer2_Avalonia.Views.Settings.PlaybackSettingsView"
             x:DataType="vm:PlaybackSettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-form" Spacing="14" MaxWidth="560" HorizontalAlignment="Stretch">
      <TextBlock Text="{DynamicResource Text.Playback}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource Text.AudioOutput}" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding AvailableAudioDevices}"
                SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                IsEnabled="{Binding CanSelectAudioOutput}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{DynamicResource Text.AudioOutput}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="audio:AudioOutputDevice">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="{DynamicResource Text.RefreshDevices}" Command="{Binding RefreshAudioDevicesCommand}"
              IsEnabled="{Binding CanSelectAudioOutput}" />
      <TextBlock Text="{Binding AudioDeviceMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding AudioDeviceMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="{DynamicResource Theme.Brush.TextMuted}" />
      <CheckBox IsChecked="{Binding RememberPlaybackPosition, Mode=TwoWay}">
        <TextBlock Text="{DynamicResource Text.RememberPosition}" TextWrapping="Wrap" />
      </CheckBox>
      <CheckBox IsChecked="{Binding ContinuePlaybackOnPlaylistChange, Mode=TwoWay}">
        <TextBlock Text="{DynamicResource Text.ContinuePlayback}" TextWrapping="Wrap" />
      </CheckBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
