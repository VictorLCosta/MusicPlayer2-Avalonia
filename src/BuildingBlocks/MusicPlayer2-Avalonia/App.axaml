<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicPlayer2_Avalonia.App"
             xmlns:local="using:MusicPlayer2_Avalonia"
             RequestedThemeVariant="{x:Static local:AppThemes.Original}">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <StyleInclude Source="avares://MusicPlayer2-Avalonia/Styles/Styles.axaml" />
    </Application.Styles>
</Application>
