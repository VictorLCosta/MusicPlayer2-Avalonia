<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicPlayer2_Avalonia.ViewModels.Settings"
             xmlns:app="using:MusicPlayer2_Avalonia" xmlns:settings="using:MusicPlayer2_Avalonia.Application.Settings.Models"
             x:Class="MusicPlayer2_Avalonia.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-form" Spacing="14" MaxWidth="560" HorizontalAlignment="Stretch">
      <TextBlock Text="{DynamicResource Text.General}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource Text.Language}" FontWeight="SemiBold" />
      <ComboBox HorizontalAlignment="Stretch" SelectedValue="{Binding Language, Mode=TwoWay}"
                SelectedValueBinding="{ReflectionBinding Tag}"
                AutomationProperties.Name="{DynamicResource Text.Language}">
        <ComboBoxItem Content="{DynamicResource Text.SystemLanguage}" Tag="system" />
        <ComboBoxItem Content="English" Tag="en" />
        <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
        <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
      </ComboBox>
      <TextBlock IsVisible="{x:Static app:App.IsMobile}" Text="{DynamicResource Text.BackgroundPlayback}" TextWrapping="Wrap" />
      <StackPanel Spacing="14" IsVisible="{x:Static app:App.IsDesktop}">
      <TextBlock Text="{DynamicResource Text.CloseBehavior}" FontWeight="SemiBold" />
      <ComboBox HorizontalAlignment="Stretch"
                SelectedValue="{Binding CloseBehavior, Mode=TwoWay}"
                SelectedValueBinding="{ReflectionBinding Tag}">
        <ComboBoxItem Content="{DynamicResource Text.ExitApplication}" Tag="{x:Static settings:WindowCloseBehavior.Exit}" />
        <ComboBoxItem Content="{DynamicResource Text.MinimizeToTray}" Tag="{x:Static settings:WindowCloseBehavior.MinimizeToTray}" />
      </ComboBox>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
