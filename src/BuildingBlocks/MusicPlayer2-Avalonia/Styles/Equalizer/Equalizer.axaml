<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MusicPlayer2_Avalonia.Models"
             x:Class="MusicPlayer2_Avalonia.Styles.Equalizer.Equalizer"
             x:Name="Root">
  <ItemsControl ItemsSource="{Binding Bands, ElementName=Root}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="models:EqualizerBand">
        <StackPanel Width="48" Spacing="8">
          <TextBlock Text="{Binding Gain, StringFormat='{}{0:+0;-0;0} dB'}" HorizontalAlignment="Center" FontSize="12" />
          <Slider Orientation="Vertical" Height="165" Minimum="-12" Maximum="12" TickFrequency="1"
                  IsSnapToTickEnabled="True" Value="{Binding Gain, Mode=TwoWay}"
                  HorizontalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
          <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
