<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicPlayer2_Avalonia.ViewModels.Settings"
             xmlns:settings="using:MusicPlayer2_Avalonia.Application.Settings.Models"
             x:Class="MusicPlayer2_Avalonia.Views.Settings.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-form" Spacing="14" MaxWidth="560" HorizontalAlignment="Stretch">
      <TextBlock Text="{DynamicResource Text.Appearance}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource Text.Theme}" FontWeight="SemiBold" />
      <ComboBox HorizontalAlignment="Stretch"
                SelectedValue="{Binding Theme, Mode=TwoWay}"
                SelectedValueBinding="{ReflectionBinding Tag}">
        <ComboBoxItem Content="{DynamicResource Text.FollowSystem}" Tag="{x:Static settings:AppTheme.System}" />
        <ComboBoxItem Content="{DynamicResource Text.Light}" Tag="{x:Static settings:AppTheme.Light}" />
        <ComboBoxItem Content="{DynamicResource Text.Dark}" Tag="{x:Static settings:AppTheme.Dark}" />
      </ComboBox>
      <TextBlock Text="{DynamicResource Text.AccentColor}" FontWeight="SemiBold" />
      <TextBox Text="{Binding AccentColor, Mode=TwoWay}" PlaceholderText="#RRGGBB"
               AutomationProperties.Name="{DynamicResource Text.AccentColor}" />
      <TextBlock Text="{DynamicResource Text.AccentHint}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Theme.Brush.TextMuted}" />
      <CheckBox IsChecked="{Binding ShowAlbumCover, Mode=TwoWay}" >
        <TextBlock Text="{DynamicResource Text.ShowAlbumCover}" TextWrapping="Wrap" />
      </CheckBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
