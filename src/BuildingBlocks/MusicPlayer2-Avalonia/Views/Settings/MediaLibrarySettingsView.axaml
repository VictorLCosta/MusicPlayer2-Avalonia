<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicPlayer2_Avalonia.ViewModels.Settings"
             xmlns:settings="using:MusicPlayer2_Avalonia.Application.Settings.Models"
             x:Class="MusicPlayer2_Avalonia.Views.Settings.MediaLibrarySettingsView"
             x:DataType="vm:MediaLibrarySettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="20" MaxWidth="560" HorizontalAlignment="Stretch">
      <TextBlock Text="Biblioteca de mídia" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Pastas de músicas" FontWeight="SemiBold" />
      <ListBox x:Name="FoldersList" ItemsSource="{Binding LibraryFolders}" Height="160"
               AutomationProperties.Name="Pastas de músicas">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Adicionar pasta" Click="AddFolderClicked" />
        <Button Content="Remover" Click="RemoveFolderClicked"
                IsEnabled="{Binding #FoldersList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <TextBlock x:Name="FolderError" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource Theme.Brush.Danger}" />
      <CheckBox IsChecked="{Binding UpdateLibraryOnStartup, Mode=TwoWay}">
        <TextBlock Text="Atualizar a biblioteca ao iniciar" TextWrapping="Wrap" />
      </CheckBox>
      <CheckBox IsChecked="{Binding RemoveMissingFilesFromLibrary, Mode=TwoWay}">
        <TextBlock Text="Remover referências a arquivos inexistentes" TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock Text="Essa opção não exclui arquivos do disco." TextWrapping="Wrap"
                 Foreground="{DynamicResource Theme.Brush.TextMuted}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

