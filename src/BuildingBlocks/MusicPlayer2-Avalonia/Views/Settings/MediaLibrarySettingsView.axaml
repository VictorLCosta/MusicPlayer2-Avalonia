<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicPlayer2_Avalonia.ViewModels.Settings"
             xmlns:app="using:MusicPlayer2_Avalonia" xmlns:settings="using:MusicPlayer2_Avalonia.Application.Settings.Models"
             x:Class="MusicPlayer2_Avalonia.Views.Settings.MediaLibrarySettingsView"
             x:DataType="vm:MediaLibrarySettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-form" Spacing="14" MaxWidth="560" HorizontalAlignment="Stretch">
      <TextBlock Text="{DynamicResource Text.MediaLibrary}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock IsVisible="{x:Static app:App.IsMobile}" Text="{DynamicResource Text.MobileImportHint}" TextWrapping="Wrap" />
      <StackPanel Spacing="14" IsVisible="{x:Static app:App.IsDesktop}">
      <TextBlock Text="{DynamicResource Text.MusicFolders}" FontWeight="SemiBold" />
      <ListBox x:Name="FoldersList" ItemsSource="{Binding LibraryFolders}" Height="160"
               AutomationProperties.Name="{DynamicResource Text.MusicFolders}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Classes="settings-folder-actions">
        <Button Content="{DynamicResource Text.AddFolder}" Click="AddFolderClicked" />
        <Button Content="{DynamicResource Text.Remove}" Click="RemoveFolderClicked"
                IsEnabled="{Binding #FoldersList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </WrapPanel>
      <TextBlock x:Name="FolderError" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource Theme.Brush.Danger}" />
      <CheckBox IsChecked="{Binding UpdateLibraryOnStartup, Mode=TwoWay}">
        <TextBlock Text="{DynamicResource Text.UpdateLibraryOnStartup}" TextWrapping="Wrap" />
      </CheckBox>
      <CheckBox IsChecked="{Binding RemoveMissingFilesFromLibrary, Mode=TwoWay}">
        <TextBlock Text="{DynamicResource Text.RemoveMissingFiles}" TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock Text="{DynamicResource Text.MissingFilesHint}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Theme.Brush.TextMuted}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
